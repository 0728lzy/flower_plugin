<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_demo_main_bg"
    tools:context=".ui.fragment.PetManagementFragment">

    <!-- 主内容区域 -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 标题区域 -->
            <LinearLayout
                android:layout_marginTop="@dimen/_20sdp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="宠物档案"
                    android:textColor="@color/color_9C27B0"
                    android:textSize="@dimen/_25sdp"
                    android:textStyle="bold"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="记录与宠物的美好时光"
                    android:textColor="#4A5565"
                    android:textSize="14dp"
                    android:layout_gravity="center_horizontal" />

            </LinearLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/adv"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginVertical="@dimen/_5sdp"
                android:background="@color/white"
                app:layout_constraintTop_toBottomOf="@id/tv_subtitle">

                <FrameLayout
                    android:id="@+id/feed_container_mg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:layout_constraintDimensionRatio="375:375"
                    app:layout_constraintLeft_toLeftOf="parent"
                    app:layout_constraintRight_toRightOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- 我的宠物标题和添加按钮 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="我的宠物"
                        android:textColor="@color/color_333333"
                        android:textSize="18dp"
                        android:textStyle="bold" />

                    <TextView
                        android:padding="@dimen/dp_10"
                        android:id="@+id/btn_add_pet"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="+ 添加宠物"
                        android:layout_gravity="center"
                        android:textColor="@android:color/white"
                        android:textSize="12dp"
                        android:background="@drawable/bg_button_add_pet"/>

                </LinearLayout>

                <!-- 宠物列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_pets"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    tools:listitem="@layout/item_pet_card"
                    tools:itemCount="2" />

                <!-- 空状态视图 -->
                <LinearLayout
                    android:id="@+id/layout_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:src="@drawable/ic_pets_purple"
                        android:alpha="0.5"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="还没有添加宠物"
                        android:textColor="@color/color_999999"
                        android:textSize="16dp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="点击上方按钮添加您的第一只宠物吧"
                        android:textColor="@color/color_CCCCCC"
                        android:textSize="14dp" />

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/ym_add_dangan"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_item_pet_mine_word"
                android:paddingHorizontal="16dp"
                android:paddingVertical="32dp"
                android:layout_marginVertical="6dp"
                android:orientation="horizontal"
                android:gravity="center">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/icon_tab_da_fun4"
                    app:tint="#99A1AF" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="添加宠物档案"
                    android:layout_marginHorizontal="10dp"
                    android:textSize="14dp"
                    android:textColor="#4A5565"/>
            </LinearLayout>
            
            <LinearLayout
                android:id="@+id/layout_pet_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_item_pet_mine_word"
                android:paddingHorizontal="16dp"
                android:paddingVertical="20dp"
                android:layout_marginVertical="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/icon_tab_da_fun1"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="宠物相册"
                    android:layout_marginHorizontal="10dp"
                    android:textSize="14dp"
                    android:textColor="@color/black"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/icon_tab_da_fun4"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_pet_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_item_pet_mine_word"
                android:paddingHorizontal="16dp"
                android:paddingVertical="20dp"
                android:layout_marginVertical="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/icon_tab_da_fun2"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="记事本"
                    android:layout_marginHorizontal="10dp"
                    android:textSize="14dp"
                    android:textColor="@color/black"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/icon_tab_da_fun4"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/layout_bath_record"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_item_pet_mine_word"
                android:paddingHorizontal="16dp"
                android:paddingVertical="20dp"
                android:layout_marginVertical="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/icon_tab_da_fun3"/>
                <TextView
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="wrap_content"
                    android:text="洗澡记录"
                    android:layout_marginHorizontal="10dp"
                    android:textSize="14dp"
                    android:textColor="@color/black"/>
                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:src="@mipmap/icon_tab_da_fun4"/>
            </LinearLayout>
            
        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

    <!-- 加载状态 -->
    <ProgressBar
        android:id="@+id/progress_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:indeterminateTint="@color/color_9C27B0" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>