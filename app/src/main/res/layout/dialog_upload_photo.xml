<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/beizi_custom_dialog_shape"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- 标题栏 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="上传照片"
            android:gravity="center"
            android:textColor="@color/app_text_color"
            android:textSize="16sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:src="@drawable/ic_close" />
    </LinearLayout>

    <!-- 选择宠物 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="选择宠物"
        android:textColor="@color/app_text_color"
        android:textSize="14sp" />


    <TextView
        android:id="@+id/tv_pet_name"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/spinner_background"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:drawableRight="@drawable/down_icon"
        android:text="毛毛"
        android:textColor="@color/color_333333"
        android:textSize="14sp" />

    <!-- 照片描述 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="照片描述"
        android:textColor="@color/color_333333"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/et_description"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:layout_marginBottom="16dp"
        android:background="@drawable/spinner_background"
        android:gravity="top"
        android:hint="请输入照片描述..."
        android:inputType="textMultiLine"
        android:maxLength="200"
        android:padding="12dp"
        android:textSize="14sp" />

    <!-- 选择照片 -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:text="选择照片"
        android:textColor="@color/color_333333"
        android:textSize="14sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_select_file"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_add_pet_1"
            android:gravity="center"
            android:text="选择文件"
            android:textColor="#78909C"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/btn_select_any_file"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_button_add_pet_1"
            android:gravity="center"
            android:text="选择任意文件"
            android:textColor="#78909C"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- 选中的照片预览 -->
    <LinearLayout
        android:id="@+id/layout_photo_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="照片预览"
            android:textColor="@color/color_333333"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/iv_photo_preview"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:background="@drawable/spinner_background"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_cancel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_button_add_pet_no_line"
            android:paddingLeft="@dimen/_30sdp"
            android:paddingTop="@dimen/dp_10"
            android:paddingRight="@dimen/_30sdp"
            android:paddingBottom="@dimen/dp_10"
            android:text="取消"
            android:textColor="@color/color_333333" />

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_add_pet_10"
            android:paddingLeft="@dimen/_30sdp"
            android:paddingTop="@dimen/dp_10"
            android:paddingRight="@dimen/_30sdp"
            android:paddingBottom="@dimen/dp_10"
            android:text="保存"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>