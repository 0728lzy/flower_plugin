<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/beizi_custom_dialog_shape"
    android:orientation="vertical"
    android:padding="14dp"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <ImageView
        android:id="@+id/iv_close"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:clickable="true"
        android:focusable="true"
        android:layout_gravity="right"
        android:src="@drawable/ic_close" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="添加宠物档案"
        android:textColor="@color/app_text_color"
        android:textSize="18dp"
        android:gravity="center"
        android:textStyle="bold" />

    <!-- 宠物姓名 -->


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="宠物名字"
        android:textColor="@color/app_text_color"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:textSize="14dp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_color_f3f3f5_radius_8"
        android:padding="8dp"
        android:textSize="14dp"
        android:hint="请输入宠物姓名"
        android:maxLength="20" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:text="宠物类型"
        android:textColor="@color/app_text_color"

        android:layout_marginBottom="5dp"
        android:textSize="14dp"
        android:textStyle="bold" />
    <!-- 宠物类型 -->
    <Spinner
        android:id="@+id/spinner_type"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:textSize="14dp"
        android:background="@drawable/bg_color_f3f3f5_radius_8" />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="年龄(岁)"
        android:textColor="@color/app_text_color"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:textSize="14dp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_age"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:textSize="14dp"
        android:background="@drawable/bg_color_f3f3f5_radius_8"
        android:hint="例如：2"
        android:inputType="number" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="体重(kg)"
            android:textColor="@color/app_text_color"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="5dp"
            android:textSize="14dp"
            android:textStyle="bold" />

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_weight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:padding="8dp"
            android:textSize="14dp"
            android:background="@drawable/bg_color_f3f3f5_radius_8"
            android:hint="例如：32"
            android:inputType="numberDecimal" />
    <!-- 宠物品种 -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="品种"
        android:textColor="@color/app_text_color"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:textSize="14dp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/et_breed"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:background="@drawable/bg_color_f3f3f5_radius_8"
        android:hint="例如：金毛、英短等"
        android:textSize="14dp"
        android:inputType="text" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"

        android:text="宠物头像"
        android:textColor="@color/app_text_color"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="5dp"
        android:textSize="14dp"
        android:textStyle="bold" />
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <ImageView
            android:id="@+id/head_pic"
            android:layout_width="45dp"
            android:src="@mipmap/dialog_add_pet_headpic"
            android:layout_height="45dp"/>
        <TextView
            android:id="@+id/upload_pic"
            android:layout_width="120dp"
            android:layout_height="45dp"
            android:text="+ 上传照片"
            android:textSize="14dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:paddingVertical="6dp"
            android:layout_marginLeft="16dp"
            android:background="@drawable/bg_color_white_line_e6e6e6_radius_5"
            android:paddingHorizontal="12dp"/>
    </LinearLayout>

    <!-- 底部按钮 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/btn_save"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_button_add_pet"
            android:paddingLeft="@dimen/_30sdp"
            android:paddingTop="15dp"
            android:paddingRight="@dimen/_30sdp"
            android:paddingBottom="15dp"
            android:text="保存"
            android:gravity="center"
            android:textColor="@android:color/white" />
    </LinearLayout>

</LinearLayout>
