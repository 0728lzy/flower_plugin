<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="10dp"
    android:tag="layout/dialog_wifi_privacy_agreement">


    <LinearLayout

        android:layout_width="320dp"
        android:layout_height="match_parent"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@mipmap/bg_vip"
            android:orientation="vertical">


            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="70dp"
                android:text="永久会员限时发放中"
                android:textColor="#ff000000"
                android:textSize="18.0sp" />
            <androidx.appcompat.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:text="功能全免费纯净无广告"
                android:textColor="#ff000000"
                android:textSize="18.0sp" />

            <LinearLayout
                android:id="@+id/sp_metro_code"
                android:layout_width="120.0dip"
                android:layout_height="32.0dip"
                android:layout_marginTop="25dp"
                android:background="@drawable/bg_item_item_search_history_num"
                android:gravity="center">

                <ImageView
                    android:id="@+id/iv_show_ad2"
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginRight="4.0dip"
                    android:src="@mipmap/ic_ad_1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="立即领取"
                    android:textColor="@color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20.0dip"
                android:layout_marginBottom="10.0dip"
                android:text="放弃权益"
                android:textColor="#ff828282"
                android:textSize="14.0sp" />

        </LinearLayout>

        <FrameLayout
            android:id="@+id/fl_content_4"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="10.0dip" />

    </LinearLayout>
    <ImageView
        android:id="@+id/iv_cancel"
        android:layout_width="30dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_height="30dp"
        android:layout_marginRight="4.0dip"
        android:src="@mipmap/icon_search_cancel" />
</androidx.constraintlayout.widget.ConstraintLayout>