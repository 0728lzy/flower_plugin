<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="fill_parent"
    android:layout_height="fill_parent"
    android:background="@color/white"
    android:tag="layout/activity_permission_0">

    <androidx.constraintlayout.widget.Guideline
        android:id="@+id/guideline"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintGuide_percent="0.2" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="fill_parent"
        android:layout_height="0.0dip"
        android:layout_marginBottom="@dimen/_20sdp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/relay_ads"
        app:layout_constraintTop_toBottomOf="@+id/guideline">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            android:paddingLeft="16.0dip"
            android:paddingTop="10.0dip"
            android:paddingRight="16.0dip"
            android:paddingBottom="10.0dip">

            <TextView
                android:id="@+id/tv_permission"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_marginTop="4.0dip"
                android:gravity="center"
                android:text="@string/txt_permission"
                android:textColor="#ff000000"
                android:textSize="20.0sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivPermission"
                android:layout_width="200.0dip"
                android:layout_height="200.0dip"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginBottom="@dimen/_10sdp"
                android:src="@drawable/ic_permission"
                app:layout_constraintBottom_toTopOf="@+id/tv_des"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_permission" />

            <TextView
                android:id="@+id/tv_des"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_permission"
                android:layout_marginTop="18.0dip"
                android:gravity="center"
                android:lineSpacingExtra="3.0dip"
                android:text="@string/txt_permission_des_1"
                android:textColor="#ff343944"
                android:textSize="@dimen/_10ssp"
                app:layout_constraintBottom_toTopOf="@+id/fr_allow"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

            <FrameLayout
                android:id="@+id/fr_allow"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/tv_des"
                android:layout_marginTop="@dimen/_4sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/tv_des">

                <RelativeLayout
                    android:id="@+id/tr_check"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8.0dip"
                    android:layout_marginTop="20.0dip"
                    android:layout_marginRight="8.0dip"
                    android:layout_marginBottom="@dimen/_5sdp"
                    android:background="@drawable/bg_duration"
                    android:backgroundTint="@color/white"
                    android:clickable="true"
                    android:elevation="8.0dip"
                    android:focusable="true"
                    android:paddingLeft="12.0dip"
                    android:paddingTop="14.0dip"
                    android:paddingRight="12.0dip"
                    android:paddingBottom="14.0dip">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:text="@string/txt_permission_1"
                        android:textColor="#ff343944"
                        android:textSize="16.0sp" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/swPermission"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:checked="false"
                        android:clickable="false"
                        android:enabled="false"
                        android:focusable="false"
                        android:thumb="@drawable/custom_thumb"
                        app:track="@drawable/custom_track" />
                </RelativeLayout>
            </FrameLayout>

            <Button
                android:id="@+id/btn_continue2"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginLeft="6.0dip"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_marginRight="6.0dip"
                android:layout_marginBottom="@dimen/_10sdp"
                android:background="@drawable/bg_button_app_transparent"
                android:gravity="center"
                android:onClick="checkPermission"
                android:paddingTop="12.0dip"
                android:paddingBottom="12.0dip"
                android:text="@string/txt_continue"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/_14ssp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/fr_allow" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <RelativeLayout
        android:id="@+id/relay_ads"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_alignParentBottom="true"
        app:layout_constraintBottom_toBottomOf="parent">

        <FrameLayout
            android:id="@+id/fr_banner"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:tag="binding_1"
            android:visibility="visible">


        </FrameLayout>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>