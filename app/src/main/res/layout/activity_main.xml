<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nav_dead_color">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/demo_bg_color"
        android:orientation="vertical">

        <!-- 顶部背景渐变 -->
        <LinearLayout
            android:visibility="gone"
            android:id="@+id/ll_top"
            android:layout_width="match_parent"
            android:layout_height="96dp"
            android:background="@drawable/bg_top_gradient"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="58dp"
            android:paddingEnd="16dp">

            <!-- 标题文字 -->
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_10sdp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="叫声翻译"
                android:textColor="@android:color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- 头像按钮 -->
            <ImageView
                android:id="@+id/iv_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginTop="@dimen/_10sdp"
                android:background="@drawable/bg_circle_white"
                android:padding="6dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_avatar" />
        </LinearLayout>

        <androidx.coordinatorlayout.widget.CoordinatorLayout
            android:id="@+id/ll_coordinator_content"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/main_pager"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:overScrollMode="never" />

        </androidx.coordinatorlayout.widget.CoordinatorLayout>

        <include
            android:id="@+id/bottom_bar"
            layout="@layout/layout_content_bottom_bar" />
    </LinearLayout>

    <TextView
        android:id="@+id/splash_app_djid"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_16sdp"
        android:layout_marginRight="10dp"
        android:alpha="0.5"
        android:gravity="right"
        android:text=""
        android:textColor="@color/little_gray_2"
        android:textSize="12dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>