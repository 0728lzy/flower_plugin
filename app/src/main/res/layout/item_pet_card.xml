<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:padding="12dp"
    android:background="@drawable/bg_item_pet_mine_word"
    android:clickable="true"
    android:focusable="true">
    <ImageView
        android:id="@+id/iv_pet_avatar"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:scaleType="centerCrop"
        android:contentDescription="@string/app_name"
        tools:src="@drawable/icon_index1_n"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />
    <ImageView
        android:id="@+id/iv_arrow"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/ic_chevron_right"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="@color/color_999999" />
    <TextView
        android:id="@+id/tv_pet_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:text="小橘"
        android:textColor="@color/color_333333"
        android:textSize="16dp"
        android:textStyle="bold"
        app:layout_constraintLeft_toRightOf="@id/iv_pet_avatar"
        app:layout_constraintRight_toLeftOf="@id/iv_arrow"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="小橘" />
    <LinearLayout
        android:id="@+id/ll_row1"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        app:layout_constraintLeft_toRightOf="@id/iv_pet_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pet_name">

        <TextView
            android:id="@+id/tv_pet_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="类型：猫"
            android:textColor="@color/color_666666"
            android:textSize="13dp"
            tools:text="类型：猫" />

        <TextView
            android:id="@+id/tv_pet_age_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="年龄：1岁5个月"
            android:textColor="@color/color_666666"
            android:textSize="13dp"
            tools:text="年龄：1岁5个月" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_row2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        app:layout_constraintLeft_toRightOf="@id/iv_pet_avatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_row1"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:id="@+id/tv_pet_weight_number"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="体重：4.5kg"
            android:textColor="@color/color_666666"
            android:textSize="13dp"
            tools:text="体重：4.5kg" />

        <TextView
            android:id="@+id/tv_pet_breed"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="品种：橘猫"
            android:textColor="@color/color_666666"
            android:textSize="13dp"
            tools:text="品种：橘猫" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>