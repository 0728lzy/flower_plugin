<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardBackgroundColor="#2196F3"
        app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#FFF3E0"
        android:layout_marginTop="5dp"
        android:orientation="vertical">

        <!-- 主要内容区域 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 标题和日期 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_bath_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="毛毛洗澡记录"
                    android:textColor="@color/color_333333"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_bath_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2023-06-15"
                    android:textColor="@color/color_999999"
                    android:padding="5dp"
                    android:background="@drawable/bg_gray"
                    android:textSize="12sp" />

            </LinearLayout>

            <!-- 洗澡详情 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="vertical">

                <!-- 左侧信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="使用香波"
                            android:textColor="@color/color_666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_shampoo"
                            android:layout_width="wrap_content"
                            android:layout_weight="1.0"
                            android:gravity="right"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="宠物专用香波"
                            android:textColor="@color/color_333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <View
                        android:background="#e1e1e1"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="洗澡时长"
                            android:textColor="@color/color_666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1.0"
                            android:gravity="right"
                            android:text="15分钟"
                            android:textColor="@color/color_333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>
                <View
                    android:background="#e1e1e1"
                    android:layout_marginTop="5dp"
                    android:layout_marginBottom="5dp"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"/>
                <!-- 右侧信息 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="水温"
                            android:textColor="@color/color_666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_temperature"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1.0"
                            android:gravity="right"
                            android:text="38°C"
                            android:textColor="@color/color_333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>
                    <View
                        android:background="#e1e1e1"
                        android:layout_marginTop="5dp"
                        android:layout_marginBottom="5dp"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="吹风方式"
                            android:textColor="@color/color_666666"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tv_drying_method"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1.0"
                            android:gravity="right"
                            android:text="低热风"
                            android:textColor="@color/color_333333"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>
            <View
                android:background="#e1e1e1"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="5dp"
                android:layout_width="match_parent"
                android:layout_height="1dp"/>
            <!-- 备注 -->
            <TextView
                android:id="@+id/tv_notes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_no_empty_gray"
                android:padding="5dp"
                android:text="毛毛在洗澡过程中表现得很配合，毛发变得非常柔顺有光泽。"
                android:textColor="@color/color_666666"
                android:textSize="14sp"
                android:maxLines="3"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- 底部信息栏 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <!-- 宠物名称标签 -->
            <TextView
                android:visibility="invisible"
                android:id="@+id/tv_pet_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pet_name_tag"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="毛毛"
                android:textColor="@android:color/white"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- 操作按钮 -->
            <TextView
                android:id="@+id/btn_edit"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="16dp"
                android:background="@drawable/bg_button_delete_blue"
                android:padding="8dp"
                android:text="编辑"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/btn_delete"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_button_delete_red"
                android:padding="8dp"
                android:gravity="center"
                android:text="删除"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

    </LinearLayout>
    </androidx.cardview.widget.CardView>

</LinearLayout>