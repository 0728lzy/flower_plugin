<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/l48"
        android:layout_width="fill_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30.0dip"
        android:background="@drawable/ugq"
        android:paddingStart="24.0dip"
        android:paddingEnd="24.0dip"
        android:paddingBottom="24.0dip"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/ref_title"
            android:layout_width="0.0dip"
            android:layout_height="wrap_content"
            android:layout_marginTop="40.0dip"
            android:gravity="center"
            android:tag="binding_1"
            android:textColor="@color/h16"
            android:textSize="18.0sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/a1j"
            android:layout_width="fill_parent"
            android:layout_height="280.0dip"
            android:layout_marginTop="@dimen/dp_10"
            android:orientation="vertical"
            app:layout_constraintBottom_toTopOf="@+id/ske"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ref_title">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:minHeight="200.0dip">

                <TextView
                    android:id="@+id/ref_text2"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:text="@string/hej"
                    android:textColor="#db000000"
                    android:textSize="14.0sp"
                    android:textStyle="bold"
                    app:layout_constrainedWidth="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="0.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/ref_text3"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:text="@string/t8v"
                    android:textColor="#80000000"
                    android:textSize="14.0sp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/ref_text2" />

                <LinearLayout
                    android:id="@+id/dz1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_10"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toEndOf="@id/ref_text3"
                    app:layout_constraintStart_toStartOf="@id/ref_text3"
                    app:layout_constraintTop_toBottomOf="@id/ref_text3">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:src="@mipmap/aq3" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_10"
                            android:lineSpacingExtra="2dp"
                            android:lineSpacingMultiplier="1.2"
                            android:text="@string/z8r"
                            android:textColor="@color/black_1"
                            android:textSize="13dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/dp_10"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="65dp"
                            android:layout_height="65dp"
                            android:src="@mipmap/etp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/dp_10"
                            android:lineSpacingExtra="2dp"
                            android:lineSpacingMultiplier="1.2"
                            android:text="@string/hcv"
                            android:textColor="@color/black_1"
                            android:textSize="13dp" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/qbi"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/d0"
                    android:textColor="#80000000"
                    android:textSize="12.0sp"
                    app:layout_constraintEnd_toEndOf="@id/dz1"
                    app:layout_constraintStart_toStartOf="@id/dz1"
                    app:layout_constraintTop_toBottomOf="@id/dz1" />

                <TextView
                    android:id="@+id/ocz"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="15dp"
                    android:text="@string/pp9"
                    android:textColor="#db000000"
                    android:textSize="14.0sp"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="@id/qbi"
                    app:layout_constraintStart_toStartOf="@id/qbi"
                    app:layout_constraintTop_toBottomOf="@id/qbi" />


                <TextView
                    android:id="@+id/ocz1"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="@string/pt9"
                    android:textColor="#80000000"
                    android:textSize="12.0sp"
                    app:layout_constraintEnd_toEndOf="@id/ocz"
                    app:layout_constraintStart_toStartOf="@id/ocz"
                    app:layout_constraintTop_toBottomOf="@id/ocz" />


                <TextView
                    android:id="@+id/w0m"
                    android:layout_width="0.0dip"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12.0dip"
                    android:text="权限说明:"
                    android:textColor="#80000000"
                    android:textSize="14.0sp"
                    app:layout_constraintEnd_toEndOf="@id/ref_text3"
                    app:layout_constraintStart_toStartOf="@id/ref_text3"
                    app:layout_constraintTop_toBottomOf="@id/ocz1" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:orientation="vertical"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="@id/ref_text3"
                    app:layout_constraintStart_toStartOf="@id/ref_text3"
                    app:layout_constraintTop_toBottomOf="@id/w0m">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_one"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:src="@mipmap/gsj" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp_10"
                            android:layout_toRightOf="@+id/iv_one"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_one"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="设备信息"
                                android:textColor="@color/black"
                                android:textSize="13dp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="分析设备状态，保障上网安全"
                                android:textColor="#80000000"
                                android:textSize="13dp" />
                        </LinearLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/iv_two"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentLeft="true"
                            android:src="@mipmap/nyg" />

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/dp_10"
                            android:layout_toRightOf="@+id/iv_two"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="存储"
                                android:textColor="@color/black"
                                android:textSize="13dp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="5dp"
                                android:text="为您提供精准的加速服务"
                                android:textColor="#80000000"
                                android:textSize="13dp" />
                        </LinearLayout>
                    </RelativeLayout>
                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@id/ske"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/a1j">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="如您同意，请点击“同意”开始接受我们的服务。"
                    android:textColor="#80000000"
                    android:textSize="12.0sp" />
            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/y1u"
                android:layout_width="fill_parent"
                android:layout_height="48.0dip"
                android:layout_marginTop="10.0dip"
                android:background="@drawable/wqp"
                android:minHeight="48.0dip"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/hpb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="同意并继续"
                    android:textColor="#ffffffff"
                    android:textSize="16.0dip"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />
            </androidx.constraintlayout.widget.ConstraintLayout>

            <TextView
                android:id="@+id/htl"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10.0dip"
                android:gravity="center"
                android:text="@string/ra9"
                android:textColor="#80000000"
                android:textSize="14.0sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:layout_width="60.0dip"
        android:layout_height="60.0dip"
        android:src="@drawable/yai"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>