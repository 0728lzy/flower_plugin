                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_users"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="6.0dip"
                    android:layout_marginRight="15.0dip"
                    android:text="@string/agreement_dialog_title_user"
                    android:textColor="#ff333333"
                    android:textSize="14.0sp" />

                <TextView
                    android:id="@+id/tvTips"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="5.0dip"
                    android:layout_marginRight="15.0dip"
                    android:text="@string/agreement_dialog_title2"
                    android:textColor="#ff333333"
                    android:textSize="14.0sp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="6.0dip"
                    android:layout_marginRight="15.0dip"
                    android:text="@string/agreement_dialog_title3"
                    android:textColor="#ff333333"
                    android:textSize="14.0sp" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:background="@drawable/shape_license"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="15.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="15.0dip">

                    <ImageView
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:scaleType="fitXY"
                        android:src="@mipmap/ic_agreement_1" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9.0dip"
                        android:text="@string/agreement_dialog_context"
                        android:textColor="#ff999999"
                        android:textSize="12.0sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:background="@drawable/shape_license"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="15.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="15.0dip">

                    <ImageView
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:scaleType="fitXY"
                        android:src="@mipmap/ic_agreement_2" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9.0dip"
                        android:text="@string/agreement_dialog_context2"
                        android:textColor="#ff999999"
                        android:textSize="12.0sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <TextView
                    android:id="@+id/tv_s_p"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:text="@string/agreement_dialog_context3"
                    android:textColor="#ff333333"
                    android:textSize="14.0sp" />

                <TextView
                    android:id="@+id/tvTips2"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:text="@string/agreement_dialog_context9"
                    android:textColor="#ff999999"
                    android:textSize="12.0sp" />

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="6.0dip"
                    android:layout_marginRight="15.0dip"
                    android:text="@string/agreement_dialog_context10"
                    android:textColor="#ff333333"
                    android:textSize="14.0sp" />

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:background="@drawable/shape_license"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="15.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="15.0dip">

                    <ImageView
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:scaleType="fitXY"
                        android:src="@mipmap/ic_agreement_3" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9.0dip"
                        android:text="@string/agreement_dialog_context11"
                        android:textColor="#ff999999"
                        android:textSize="12.0sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:background="@drawable/shape_license"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="15.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="15.0dip">

                    <ImageView
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:scaleType="fitXY"
                        android:src="@mipmap/ic_agreement_4" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9.0dip"
                        android:text="@string/agreement_dialog_context12"
                        android:textColor="#ff999999"
                        android:textSize="12.0sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:background="@drawable/shape_license"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="15.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="15.0dip">

                    <ImageView
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:scaleType="fitXY"
                        android:src="@mipmap/ic_agreement_5" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9.0dip"
                        android:text="@string/agreement_dialog_context13"
                        android:textColor="#ff999999"
                        android:textSize="12.0sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:background="@drawable/shape_license"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingLeft="9.0dip"
                    android:paddingTop="15.0dip"
                    android:paddingRight="9.0dip"
                    android:paddingBottom="15.0dip">

                    <ImageView
                        android:layout_width="35.0dip"
                        android:layout_height="35.0dip"
                        android:scaleType="fitXY"
                        android:src="@mipmap/ic_agreement_6" />

                    <TextView
                        android:layout_width="fill_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="9.0dip"
                        android:text="@string/agreement_dialog_context14"
                        android:textColor="#ff999999"
                        android:textSize="12.0sp" />
                </androidx.appcompat.widget.LinearLayoutCompat>

                <TextView
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="15.0dip"
                    android:layout_marginTop="10.0dip"
                    android:layout_marginRight="15.0dip"
                    android:text="@string/agreement_dialog_context17"
                    android:textColor="#ff333333"
                    android:textSize="14.0sp" />
            </androidx.appcompat.widget.LinearLayoutCompat>
        </ScrollView>
        <TextView
            android:id="@+id/but_agreement"
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10.0dip"
            android:gravity="center"
            android:text="@string/agreement_dialog_context4"
            android:textColor="#ff999999"
            android:textSize="12.0sp" />
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="fill_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15.0dip"
            android:layout_marginBottom="15.0dip"
            android:orientation="horizontal">

            <TextView
